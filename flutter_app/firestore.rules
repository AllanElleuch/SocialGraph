rules_version = '2';

// Security rules for SocialGraph (project: socialgraph-69110).
//
// Data model:
//   users/{uid}                     -> cloud sync document (contacts array)
//   users/{uid}/backups/{backupId}  -> cloud backup snapshots
//
// A signed-in user (anonymous or email/password) may read and write ONLY their
// own data. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: the request is authenticated as the owner of {userId}.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The user's sync document AND everything beneath it (the backups
    // subcollection, plus any future subcollections). The recursive {document=**}
    // wildcard is what makes the rule apply to subcollections — a plain
    // `match /users/{userId}` alone does NOT cover them, which is why a ruleset
    // missing this denied users/{uid}/backups while allowing users/{uid}.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
